# ==============================================================================
# Google Cloud Platform & Application Configuration
# ==============================================================================

# Port for the Flask server (Cloud Run automatically injects PORT=8080)
PORT=8080

# Your Google Cloud Project ID (e.g. gmiu-cloud-practical-2026)
# Required when testing locally. When deployed to Cloud Run, this is auto-detected.
GCP_PROJECT_ID=your-google-cloud-project-id

# Firestore Database ID (leave as (default) unless you created a named database)
FIRESTORE_DATABASE=(default)

# Path to your downloaded Service Account JSON key (Only needed for local testing)
# Example: GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json
# NEVER commit your real service-account-key.json to Git!
GOOGLE_APPLICATION_CREDENTIALS=

# Preferred Google Cloud Region (e.g. asia-south1 for Mumbai, India)
CLOUD_RUN_REGION=asia-south1 (Mumbai)

# Flask Environment mode
FLASK_ENV=development
